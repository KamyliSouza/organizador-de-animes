index c6d674f..ea7961b 100644
--- a/js/core/errors.js
+++ b/js/core/errors.js
@@ -11,3 +11,17 @@ export class AppError extends Error {
 export function messageOf(err, fallback = 'Algo deu errado. Tente novamente.') {
     return err?.userMessage || fallback;
 }
+
+const NETWORK_RX = /failed to fetch|networkerror|network request failed|load failed|fetch failed|internet disconnected|network error|retryablefetch/i;
+
+/**
+ * O erro veio de falta de internet (e não de uma recusa do banco)? Olha o erro e a causa dele (o AppError guarda o erro original do Supabase).
+ * Serve para decidir se vale mostrar a cópia da biblioteca guardada neste aparelho.
+ */
+export function isNetworkError(err) {
+    for (let e = err, depth = 0; e && depth < 3; e = e.cause, depth += 1) {
+        if (e instanceof TypeError) return true;
+        if (NETWORK_RX.test(`${e.name || ''} ${e.message || ''}`)) return true;
+    }
+    return false;
+}
diff --git a/js/core/offlineStore.js b/js/core/offlineStore.js
new file mode 100644
index 0000000..e7f8b2c
--- /dev/null
+++ b/js/core/offlineStore.js
@@ -0,0 +1,35 @@
+// Armazenamento para "ver offline": um IndexedDB minúsculo (chave → valor). Bem maior que o localStorage, que estouraria com bibliotecas grandes.
+// Tudo é à prova de falha: navegador sem IndexedDB, janela privada ou disco cheio devolvem "nada" e o site segue normal (só não há cópia offline).
+const DB = 'kamylist-offline';
+const STORE = 'kv';
+let opening = null;
+
+function open() {
+    if (opening) return opening;
+    opening = new Promise((resolve, reject) => {
+        if (typeof indexedDB === 'undefined') { reject(new Error('sem IndexedDB')); return; }
+        let req;
+        try { req = indexedDB.open(DB, 1); } catch (e) { reject(e); return; }
+        req.onupgradeneeded = () => { if (!req.result.objectStoreNames.contains(STORE)) req.result.createObjectStore(STORE); };
+        req.onsuccess = () => resolve(req.result);
+        req.onerror = () => reject(req.error);
+        req.onblocked = () => reject(new Error('bloqueado'));
+    }).catch((e) => { opening = null; throw e; });
+    return opening;
+}
+
+async function tx(mode, run) {
+    const db = await open();
+    return new Promise((resolve, reject) => {
+        const t = db.transaction(STORE, mode);
+        const out = run(t.objectStore(STORE));
+        t.oncomplete = () => resolve(out && 'result' in out ? out.result : undefined);
+        t.onerror = () => reject(t.error);
+        t.onabort = () => reject(t.error || new Error('cancelado'));
+    });
+}
+
+export async function kvGet(key) { try { return (await tx('readonly', (s) => s.get(key))) ?? null; } catch { return null; } }
+export async function kvSet(key, value) { try { await tx('readwrite', (s) => s.put(value, key)); return true; } catch { return false; } }
+export async function kvDel(key) { try { await tx('readwrite', (s) => s.delete(key)); return true; } catch { return false; } }
+export async function kvKeys() { try { return (await tx('readonly', (s) => s.getAllKeys())) || []; } catch { return []; } }
diff --git a/js/core/online.js b/js/core/online.js
new file mode 100644
index 0000000..27c39e8
--- /dev/null
+++ b/js/core/online.js
@@ -0,0 +1,18 @@
+// "Estou sem internet?" em um lugar só. Vale quando o navegador avisa (navigator.onLine) e também quando uma chamada de rede falhou
+// mesmo com o navegador achando que há conexão (Wi-Fi sem sinal): `markNetworkFailure()` marca, e a próxima chamada que der certo
+// (`markNetworkOk()`) ou o evento "online" desmarca. Quem muda de comportamento sem internet (barra, biblioteca, telas) ouve onConnectionChange.
+const listeners = new Set();
+let failed = false;
+
+export const isOffline = () => (typeof navigator !== 'undefined' && navigator.onLine === false) || failed;
+export function onConnectionChange(fn) { listeners.add(fn); return () => listeners.delete(fn); }
+
+const emit = () => listeners.forEach((fn) => { try { fn(isOffline()); } catch (e) { console.error(e); } });
+
+export function markNetworkFailure() { if (!failed) { failed = true; emit(); } }
+export function markNetworkOk() { if (failed) { failed = false; emit(); } }
+
+if (typeof window !== 'undefined') {
+    window.addEventListener('offline', emit);
+    window.addEventListener('online', () => { failed = false; emit(); });
+}

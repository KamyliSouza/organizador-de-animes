+        await cache.addAll(PRECACHE.map((p) => new Request(new URL(p, SCOPE), { cache: 'reload' })));
+        // As chaves da pessoa: guarda uma cópia para abrir offline (melhor esforço; a falha não impede a instalação).
+        try {

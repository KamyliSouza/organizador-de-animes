+        });
+
+        zoomInput.addEventListener('input', () => { if (view) set(zoomAt(view, Number(zoomInput.value) / 100, iw, ih, box())); });
+        content.querySelector('[data-crop-reset]').addEventListener('click', () => { if (view) set(initialView(iw, ih)); });

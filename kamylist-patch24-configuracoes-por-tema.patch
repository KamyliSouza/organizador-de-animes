+            }
+            renderLink(updated);
+            toast('Privacidade salva!', { type: 'success' });
+        } catch (err) {
+            console.error(err);
+            toast(messageOf(err), { type: 'error' });
+        } finally {
+            btn.disabled = false;
+            btn.textContent = 'Salvar privacidade';
+        }

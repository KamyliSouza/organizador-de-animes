+    offs.push(on(root, 'click', '[data-act="copy"]', async () => {
+        const ok = await copyText(root.querySelector('[data-link]').value);
+        toast(ok ? 'Link copiado!' : 'Não foi possível copiar o link.', { type: ok ? 'success' : 'error' });

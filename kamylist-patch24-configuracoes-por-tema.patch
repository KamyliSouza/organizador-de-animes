+        || (!state.access.forcePrivateNotes && $('#st-notes').checked !== state.profile.showNotes)
+        || checkedSections().join() !== normalizeSections(state.profile.sections).join();
+
+    return { off: () => offs.forEach((off) => off()), isDirty };
